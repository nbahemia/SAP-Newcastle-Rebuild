# ============================================================
# SAP-Newcastle-Rebuild
# ============================================================

# ------------------------------------------------------------
# Python environments / caches
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ------------------------------------------------------------
# Environment variables / secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------
# IDE / editor / OS clutter
# ------------------------------------------------------------
.vscode/
.idea/
*.code-workspace

.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Temporary / local files
# ------------------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
~$*
downloaded_files/

# ------------------------------------------------------------
# Archive generated by repo cleanup
# ------------------------------------------------------------
archive/

# ------------------------------------------------------------
# Reports generated during audits / maintenance
# ------------------------------------------------------------
reports/

# ------------------------------------------------------------
# Raw football data
# Large, downloaded, and reproducible.
# ------------------------------------------------------------
data/raw/

# ------------------------------------------------------------
# External local databases / caches
# Transfermarkt DuckDB is a local data dependency, not source code.
# ------------------------------------------------------------
data/external/**/*.duckdb
data/external/**/*.db
data/external/**/*.sqlite
data/external/**/*.sqlite3

# ------------------------------------------------------------
# Processed data
#
# Ignore generated analytical datasets by default.
# Small decision-layer CSVs are selectively retained below.
# ------------------------------------------------------------
data/processed/**/*.parquet
data/processed/**/*.html
data/processed/**/*.json
data/processed/**/*.jsonl
data/processed/**/*.feather
data/processed/**/*.pickle
data/processed/**/*.pkl

# Generated/intermediate CSVs under processed data
data/processed/**/*.csv

# ------------------------------------------------------------
# Keep the small recruitment decision files that are useful
# project outputs / reproducibility checkpoints.
# ------------------------------------------------------------
!data/processed/bsd/
!data/processed/bsd/shortlist/
!data/processed/bsd/shortlist/current_transfer_overrides.csv
!data/processed/bsd/shortlist/final_recruitment_focus/
!data/processed/bsd/shortlist/final_recruitment_focus/top_10_elite_complete_rw.csv
!data/processed/bsd/shortlist/final_recruitment_focus/top_20_high_line_succession_cb.csv

# ------------------------------------------------------------
# Visualizations
#
# Root visualizations/ is the canonical generated image tree.
# Keep directory structure/documentation local, but do not track
# rendered images unless you intentionally force-add one.
# ------------------------------------------------------------
visualizations/**/*.png
visualizations/**/*.jpg
visualizations/**/*.jpeg
visualizations/**/*.webp
visualizations/**/*.svg
visualizations/**/*.pdf

# ------------------------------------------------------------
# Jupyter
# ------------------------------------------------------------
.ipynb_checkpoints/

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
*.log
logs/

# ------------------------------------------------------------
# Packaging / build artifacts
# ------------------------------------------------------------
build/
dist/
*.egg-info/
.eggs/

# ------------------------------------------------------------
# Optional local profiling / notebook artifacts
# ------------------------------------------------------------
.profile/
.cache/

#------------------------------------------------------------
# Maintenance
#------------------------------------------------------------
scripts/maintenance/