from pathlib import Path

import pandas as pd


# ---------------------------------------------------------
# Paths
# ---------------------------------------------------------

PROJECT_ROOT = Path(__file__).resolve().parents[3]

PROCESSED = PROJECT_ROOT / "data" / "processed"

INPUT_FILE = (
    PROCESSED
    / "player_percentiles.parquet"
)

OUTPUT_FILE = (
    PROCESSED
    / "role_analysis"
    / "striker_scouting_shortlist.parquet"
)


# ---------------------------------------------------------
# Settings
# ---------------------------------------------------------

MIN_MINUTES = 270

ROLE_NAME = "Jaissle Line-Leading No. 9"


# ---------------------------------------------------------
# Jaissle No. 9 Weights
# ---------------------------------------------------------
#
# Based on the shared characteristics of:
#
# - Benjamin Sesko under Jaissle
# - Ivan Toney under Jaissle
#
# The role emphasizes:
#
# 1. Shot / goal threat
# 2. Penalty-box activity
# 3. Front-line pressing
# 4. Duel involvement
#
# It intentionally DOES NOT reward:
#
# - high passing volume
# - progressive passing
# - progressive carrying
#
# Those characteristics can identify good attackers,
# but do not specifically identify the type of line-leading
# striker we are trying to find.
#
# Total = 1.00
# ---------------------------------------------------------

STRIKER_WEIGHTS = {
    "xg_percentile": 0.25,
    "shots_in_box_percentile": 0.20,
    "shots_percentile": 0.15,
    "goals_percentile": 0.10,

    "attacking_third_pressures_percentile": 0.125,
    "pressures_percentile": 0.075,

    "duels_percentile": 0.10,
}


# ---------------------------------------------------------
# Pure No. 9 Weights
# ---------------------------------------------------------
#
# Even narrower interpretation of the role.
#
# This score asks:
#
# "Does this player statistically behave like a genuine
# penalty-box / line-leading striker?"
#
# Total = 1.00
# ---------------------------------------------------------

PURE_9_WEIGHTS = {
    "xg_percentile": 0.30,
    "shots_in_box_percentile": 0.25,
    "shots_percentile": 0.15,
    "goals_percentile": 0.10,

    "duels_percentile": 0.10,

    "attacking_third_pressures_percentile": 0.10,
}


# ---------------------------------------------------------
# Validate Weights
# ---------------------------------------------------------

def validate_weights():

    striker_total = sum(
        STRIKER_WEIGHTS.values()
    )

    pure_9_total = sum(
        PURE_9_WEIGHTS.values()
    )

    if abs(striker_total - 1.0) > 1e-9:
        raise ValueError(
            "STRIKER_WEIGHTS must sum to 1.0. "
            f"Current total: {striker_total:.4f}"
        )

    if abs(pure_9_total - 1.0) > 1e-9:
        raise ValueError(
            "PURE_9_WEIGHTS must sum to 1.0. "
            f"Current total: {pure_9_total:.4f}"
        )


# ---------------------------------------------------------
# Validate Required Columns
# ---------------------------------------------------------

def validate_columns(
    dataframe: pd.DataFrame,
    required_columns: list[str],
    model_name: str,
):

    missing = [
        column
        for column in required_columns
        if column not in dataframe.columns
    ]

    if missing:

        message = (
            f"\nMissing metrics required for "
            f"{model_name}:\n"
        )

        for column in missing:
            message += f"  - {column}\n"

        raise ValueError(message)


# ---------------------------------------------------------
# General Jaissle No. 9 Score
# ---------------------------------------------------------

def calculate_striker_fit(
    candidates: pd.DataFrame,
) -> pd.DataFrame:

    candidates = candidates.copy()

    validate_columns(
        candidates,
        list(STRIKER_WEIGHTS.keys()),
        "Jaissle No. 9 model",
    )

    candidates["striker_fit_score"] = 0.0

    for metric, weight in STRIKER_WEIGHTS.items():

        candidates["striker_fit_score"] += (
            candidates[metric]
            * weight
        )

    candidates["striker_fit_score"] = (
        candidates["striker_fit_score"]
        .round(1)
    )


    # -----------------------------------------------------
    # Component Scores
    # -----------------------------------------------------

    candidates["goal_threat_score"] = (
        candidates[
            [
                "xg_percentile",
                "shots_in_box_percentile",
                "shots_percentile",
                "goals_percentile",
            ]
        ]
        .mean(axis=1)
        .round(1)
    )


    candidates["box_threat_score"] = (
        candidates[
            [
                "xg_percentile",
                "shots_in_box_percentile",
            ]
        ]
        .mean(axis=1)
        .round(1)
    )


    candidates["pressing_score"] = (
        (
            candidates[
                "attacking_third_pressures_percentile"
            ]
            * 0.625
        )
        +
        (
            candidates[
                "pressures_percentile"
            ]
            * 0.375
        )
    ).round(1)


    candidates["duel_score"] = (
        candidates[
            "duels_percentile"
        ]
        .round(1)
    )


    return candidates


# ---------------------------------------------------------
# Pure No. 9 Score
# ---------------------------------------------------------

def calculate_pure_9_fit(
    candidates: pd.DataFrame,
) -> pd.DataFrame:

    candidates = candidates.copy()

    validate_columns(
        candidates,
        list(PURE_9_WEIGHTS.keys()),
        "Pure No. 9 model",
    )

    candidates["pure_9_fit_score"] = 0.0

    for metric, weight in PURE_9_WEIGHTS.items():

        candidates["pure_9_fit_score"] += (
            candidates[metric]
            * weight
        )

    candidates["pure_9_fit_score"] = (
        candidates["pure_9_fit_score"]
        .round(1)
    )


    # -----------------------------------------------------
    # Pure-9 Components
    # -----------------------------------------------------

    candidates["pure_9_scoring_score"] = (
        candidates[
            [
                "xg_percentile",
                "shots_in_box_percentile",
                "shots_percentile",
                "goals_percentile",
            ]
        ]
        .mean(axis=1)
        .round(1)
    )


    candidates["pure_9_duel_score"] = (
        candidates[
            "duels_percentile"
        ]
        .round(1)
    )


    candidates["pure_9_pressing_score"] = (
        candidates[
            "attacking_third_pressures_percentile"
        ]
        .round(1)
    )


    return candidates


# ---------------------------------------------------------
# Build Striker Shortlist
# ---------------------------------------------------------

def build_striker_shortlist(
    players: pd.DataFrame,
) -> pd.DataFrame:

    required_base_columns = [
        "player",
        "team",
        "primary_position_group",
        "minutes",
    ]

    validate_columns(
        players,
        required_base_columns,
        "striker shortlist",
    )


    # -----------------------------------------------------
    # Filter to observed strikers
    # -----------------------------------------------------

    candidates = players[
        (
            players["primary_position_group"]
            == "ST"
        )
        &
        (
            players["minutes"]
            >= MIN_MINUTES
        )
    ].copy()


    print(
        f"\nEligible strikers: "
        f"{len(candidates)} "
        f"(minimum {MIN_MINUTES} minutes)"
    )


    # -----------------------------------------------------
    # Calculate Models
    # -----------------------------------------------------

    candidates = calculate_striker_fit(
        candidates
    )

    candidates = calculate_pure_9_fit(
        candidates
    )


    # -----------------------------------------------------
    # Rankings
    # -----------------------------------------------------

    candidates["striker_rank"] = (
        candidates[
            "striker_fit_score"
        ]
        .rank(
            method="min",
            ascending=False,
        )
        .astype(int)
    )


    candidates["pure_9_rank"] = (
        candidates[
            "pure_9_fit_score"
        ]
        .rank(
            method="min",
            ascending=False,
        )
        .astype(int)
    )


    # -----------------------------------------------------
    # Sort
    # -----------------------------------------------------

    candidates = candidates.sort_values(
        by=[
            "striker_fit_score",
            "pure_9_fit_score",
            "minutes",
        ],
        ascending=[
            False,
            False,
            False,
        ],
    )


    # -----------------------------------------------------
    # Output Columns
    # -----------------------------------------------------

    output_columns = [

        # Rankings
        "striker_rank",
        "pure_9_rank",

        # Player info
        "player",
        "team",
        "primary_position_group",
        "secondary_position_group",
        "minutes",
        "appearances",

        # Overall scores
        "striker_fit_score",
        "pure_9_fit_score",

        # Components
        "goal_threat_score",
        "box_threat_score",
        "pressing_score",
        "duel_score",

        "pure_9_scoring_score",
        "pure_9_duel_score",
        "pure_9_pressing_score",

        # -------------------------------------------------
        # Raw /90 Metrics
        # -------------------------------------------------

        "goals_per90",
        "xg_per90",
        "shots_per90",
        "shots_in_box_per90",

        "pressures_per90",
        "attacking_third_pressures_per90",

        "duels_per90",

        # -------------------------------------------------
        # Percentiles
        # -------------------------------------------------

        "goals_percentile",
        "xg_percentile",
        "shots_percentile",
        "shots_in_box_percentile",

        "pressures_percentile",
        "attacking_third_pressures_percentile",

        "duels_percentile",
    ]


    output_columns = [
        column
        for column in output_columns
        if column in candidates.columns
    ]


    return candidates[
        output_columns
    ].copy()


