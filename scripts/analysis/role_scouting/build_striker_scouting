# ---------------------------------------------------------
# Main
# ---------------------------------------------------------

def main():

    validate_weights()


    # -----------------------------------------------------
    # Load
    # -----------------------------------------------------

    players = pd.read_parquet(
        INPUT_FILE
    )


    print(
        f"Loaded {len(players):,} "
        "eligible player rows"
    )


    # -----------------------------------------------------
    # Build shortlist
    # -----------------------------------------------------

    shortlist = (
        build_striker_shortlist(
            players
        )
    )


    # -----------------------------------------------------
    # Save
    # -----------------------------------------------------

    OUTPUT_FILE.parent.mkdir(
        parents=True,
        exist_ok=True,
    )


    shortlist.to_parquet(
        OUTPUT_FILE,
        index=False,
    )


    # -----------------------------------------------------
    # Terminal Output
    # -----------------------------------------------------

    print_role_table(
        shortlist,
        top_n=15,
    )


    print_pure_9_table(
        shortlist,
        top_n=15,
    )


    print_metric_table(
        shortlist,
        top_n=10,
    )


    print_section(
        "OUTPUT"
    )


    print(
        f"Candidates saved: "
        f"{len(shortlist)}"
    )

    print(
        f"File: {OUTPUT_FILE}"
    )

    print()


if __name__ == "__main__":
    main()