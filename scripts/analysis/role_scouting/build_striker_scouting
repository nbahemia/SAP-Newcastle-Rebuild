            "player",
            "team",
            "minutes",
            "striker_fit_score",
            "pure_9_fit_score",
            "goal_threat_score",
            "pressing_score",
            "duel_score",
        ]
    ].head(top_n).copy()


    display.columns = [
        "Rank",
        "Player",
        "Team",
        "Min",
        "Fit",
        "Pure9",
        "Goal",
        "Press",
        "Duel",
    ]


    display["Min"] = (
        display["Min"]
        .round(0)
        .astype(int)
    )


    numeric_columns = [
        "Fit",
        "Pure9",
        "Goal",
        "Press",
        "Duel",
    ]


    for column in numeric_columns:

        display[column] = (
            display[column]
            .round(1)
